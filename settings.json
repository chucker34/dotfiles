{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(git show:*)",
      "Bash(git ls-tree:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose run:*)",
      "mcp__serena__onboarding",
      "mcp__serena__list_dir",
      "mcp__serena__search_for_pattern",
      "mcp__serena__find_symbol",
      "mcp__serena__write_memory",
      "mcp__serena__think_about_collected_information",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__check_onboarding_performed"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Read(.env)",
      "Edit(.env)",
      "Read(.env.local)",
      "Edit(.env.local)",
      "Read(.env.*.local)",
      "Edit(.env.*.local)",
      "Read(.env.production*)",
      "Edit(.env.production*)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*key*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Bash(nc:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(mongod:*)",
      "mcp__supabase__execute_sql",
      "Bash(docker compose config:*)",
      "Bash(docker inspect:*)",
      "Bash(docker container inspect:*)"
    ]
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -qE '\\.aws(/|[^A-Za-z0-9_]|$)' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"~/.aws 配下への参照はユーザー設定でブロックされています\"}}' || true"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -qE 'printenv|/proc/[^ ]*/environ|docker( compose)? +(config|inspect)|(^|[;&| ])env([ ;&|]|$)' && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"環境変数(APIキー等)を表示するコマンドはユーザー設定でブロックされています\"}}' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"タスクが完了しました\" with title \"Claude Code\" subtitle \"作業が正常に完了しました\"'"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Codeが確認を求めています\" with title \"Claude Code\" subtitle \"作業の確認が必要です\"'"
          },
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Hero.aiff"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "Notion@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754043355037
  }
}
